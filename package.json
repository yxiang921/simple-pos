    "db:studio": "prisma studio",
    "test": "vitest run",
    "admin:password": "tsx scripts/set-admin-password.ts",
    "demo:history": "tsx scripts/simulate-history.ts",
    "db:check": "tsx scripts/check-data.ts",
    "db:fill": "tsx scripts/check-data.ts --fill",
    "patterns:build": "tsx scripts/build-patterns.ts"
