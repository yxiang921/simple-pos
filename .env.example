# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────
# Supabase dashboard → Project → Connect → ORMs / Connection string.
#
# Runtime connection: Transaction pooler (port 6543). Used by the Next.js app.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session connection (port 5432). Used by Prisma CLI for migrations & seeding.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# PostgreSQL schema for the POS tables. Use a dedicated schema (e.g. "pos") when the
# database is shared with another app whose tables live in "public".
DATABASE_SCHEMA="pos"

# Max connections held by each app instance's pool (keep low on serverless).
DATABASE_POOL_MAX="5"

# ── Admin session security ───────────────────────────────────────────────
# Secret used to HMAC session tokens before they are stored in the database.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Session lifetime in hours (default 12).
SESSION_TTL_HOURS="12"

# ── Initial admin account (used only by `npm run db:seed`) ───────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# ── Rate limiting (guest order submission, per client IP) ────────────────
ORDER_RATE_LIMIT_MAX="10"
ORDER_RATE_LIMIT_WINDOW_SECONDS="300"

# ── Tests only ───────────────────────────────────────────────────────────
# A SEPARATE, disposable database. Tests truncate all tables!
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_test"
